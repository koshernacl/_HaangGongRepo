# Auto detect text files and perform LF normalization
* text=auto
*.edds filter=lfs diff=lfs merge=lfs -text
*.xob filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.ent filter=lfs diff=lfs merge=lfs -text
*.layer filter=lfs diff=lfs merge=lfs -text
.txo filter=lfs diff=lfs merge=lfs -text
.pur filter=lfs diff=lfs merge=lfs -text
